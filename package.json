{
  "name": "stremio-addon-manager",
  "version": "0.0.32",
  "productName": "StremioAddonManager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "open:android": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "linux:android-debug": "node scripts/linux-android-debug.mjs",
    "deploy:android": "node scripts/deploy-android.cross-platform.mjs",
    "preview": "vite preview",
    "test": "vitest --run"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "chota": "^0.9.2",
    "vue": "^3.5.34",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
